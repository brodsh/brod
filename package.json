{
  "name": "brod",
  "version": "0.2.0",
  "private": true,
  "description": "Brod: the self-hosted cloud your AI agent deploys team tools to, over MCP. Node is used only for the end-to-end tests.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path server/Cargo.toml",
    "e2e:rust": "node scripts/e2e-rust.mjs",
    "e2e:rust:static": "node scripts/e2e-rust.mjs static",
    "e2e:rust:s3": "node scripts/e2e-rust.mjs s3",
    "e2e:rust:pg": "node scripts/e2e-rust.mjs pg",
    "e2e:self-hosted": "node scripts/e2e-self-hosted.mjs",
    "e2e:tls": "node scripts/e2e-tls.mjs",
    "gen:og": "node scripts/gen-og.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "1.56.1",
    "vitest": "^4.1.11",
    "workerd": "1.20261006.1"
  }
}
