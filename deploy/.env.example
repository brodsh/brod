# Brod on your own server. Copy to deploy/.env and fill in. Never commit the filled-in file.
# Make long random values with: openssl rand -hex 32

# Where the API, sign-in pages and workspace home pages live.
API_ORIGIN=https://brod.example.com
# The same host without https://, for Caddy.
BROD_API_HOST=brod.example.com
# Apps are served at <slug>.<workspace>.<APPS_DOMAIN>, and <workspace>.<APPS_DOMAIN> opens the workspace home page.
# Needs a wildcard DNS record (*.brod.example.com -> this server, DNS only: Cloudflare's proxy certificate covers one level).
APPS_DOMAIN=brod.example.com
# For Let's Encrypt: expiry notices go here.
ACME_EMAIL=you@example.com

# Long random values. Changing SECRETS_KEY later makes stored app secrets unreadable.
ADMIN_SECRET=
IDENTITY_SECRET=
SECRETS_KEY=
# Shared by Brod and the server-app runtime. Leave BROD_RUNTIME_URL out of docker-compose.yml to serve static apps only.
BROD_RUNTIME_SECRET=
# Optional: when the runtime's supervisor restarts workerd (README, "Limits for server apps"), and the runtime
# container's hard memory ceiling. Keep RUNTIME_MEMORY_MB below RUNTIME_MEM_LIMIT.
# RUNTIME_STALL_MS=5000
# RUNTIME_MEMORY_MB=1536
# RUNTIME_MEM_LIMIT=2g

# Where apps may send data (README, "Outside addresses"): log (default) records requests to hosts an app's brod.json
# does not declare and lets them through; enforce refuses them; off does neither. Switch to enforce once apps declare.
BROD_NETWORK=log

# Optional: marketplace previews Brod takes itself (docker compose --profile previews up -d). Set both, with a long
# random secret; leave them empty and listings show only the screenshots people upload.
BROD_PREVIEW_URL=
BROD_PREVIEW_SECRET=

# Sign-in and invitation emails, through Resend (https://resend.com). EMAIL_FROM is required with RESEND_API_KEY and
# must be a sender Resend has verified, for example: Brod <brod@example.com>
RESEND_API_KEY=
EMAIL_FROM=

# Optional: "Continue with Google". Redirect URI: <API_ORIGIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: billing through Stripe. Create two recurring prices, a webhook endpoint at <API_ORIGIN>/stripe/webhook
# (checkout.session.completed, customer.subscription.created/updated/deleted), and turn on the customer portal.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_SOLO=price_...
# STRIPE_PRICE_TEAM=price_...

# Optional: app files in an S3-compatible bucket (Cloudflare R2, AWS S3, MinIO) instead of the brod-data volume.
# With the bundled MinIO (docker compose --profile minio up -d): S3_ENDPOINT=http://minio:9000
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_BUCKET=brod-bundles
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_VIRTUAL_HOSTED=0

# Optional: Brod's own database in Postgres instead of SQLite (brod.db in the brod-data volume).
# With the bundled Postgres (docker compose --profile postgres up -d): BROD_DATABASE_URL=postgres://brod:<POSTGRES_PASSWORD>@postgres:5432/brod
# Moving an existing SQLite database over: see "Postgres instead of SQLite" in README.md.
# POSTGRES_PASSWORD=
# BROD_DATABASE_URL=postgres://brod:<password>@postgres:5432/brod

# Never on a public server: DEV_MODE=1 returns sign-in links in API responses.
# DEV_MODE=1

# Optional: a Google Analytics 4 measurement ID for the public landing page only. Unset: no Google tag anywhere.
# BROD_GA_ID=
