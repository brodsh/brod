{
  // Brod: control plane, MCP endpoint, sign-in and gateway in one Worker.
  "name": "brod",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  // ctx.exports gives server apps loopback stubs to their own database, files and log sink.
  "compatibility_flags": ["enable_ctx_exports"],
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "brod", "database_id": "REPLACE_WITH_YOUR_D1_ID", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BUNDLES", "bucket_name": "brod-bundles" }],
  // Server apps: each app's server code is loaded on demand into its own isolate...
  "worker_loaders": [{ "binding": "LOADER" }],
  // ...and gets its own SQLite database, one Durable Object per app.
  "durable_objects": { "bindings": [{ "name": "APP_DATA", "class_name": "AppData" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppData"] }],
  "vars": {
    // Apps are served at <slug>.<APPS_DOMAIN>, in production "apps.brod.sh". The API host never shares a hostname
    // with an app, and on HTTPS every cookie is __Host- prefixed, so an app can neither read nor plant sign-in cookies.
    "APPS_DOMAIN": "localhost:8787",
    // Where the API, MCP endpoint, sign-in pages and workspace home pages are served.
    "API_ORIGIN": "http://localhost:8787",
    // Optional: the sender for sign-in and invitation emails (needs the RESEND_API_KEY secret).
    "EMAIL_FROM": "Brod <no-reply@brod.sh>"
  }
  // Secrets (wrangler secret put): ADMIN_SECRET, IDENTITY_SECRET, SECRETS_KEY, RESEND_API_KEY,
  // and optionally GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET for "Continue with Google".
  // After you own the domains on Cloudflare, add:
  // "routes": [
  //   { "pattern": "brod.sh", "custom_domain": true },
  //   { "pattern": "*.apps.brod.sh/*", "zone_name": "brod.sh" }   // APPS_DOMAIN = "apps.brod.sh" 
  // ]
}
