# Brod configuration. Copy to .env and set BROD_ADMIN_EMAIL; everything else has a working default.
# Each variable is described in docs/configuration.md. Lines starting with # are off.

# ---- start here ----
# The first admin. On an empty database Brod makes this person the admin of a workspace called "Default" and prints a
# one-time sign-in link to the log (docker compose logs brod).
BROD_ADMIN_EMAIL=you@example.com
# Where people and agents reach Brod. Apps live under the same host: http://<app>.<workspace>.localhost:8080.
BROD_PUBLIC_URL=http://localhost:8080

# ---- addresses ----
# The host apps are served under, when it differs from BROD_PUBLIC_URL's host (needs a wildcard DNS record).
# APPS_DOMAIN=apps.example.com
# Where Brod listens inside its container.
# BROD_LISTEN=0.0.0.0:8080
# 1 when a proxy you control (Caddy, nginx) sits in front: take the scheme and client address from X-Forwarded-*.
# BROD_TRUST_PROXY=0

# ---- secrets ----
# Generated on first start and kept in <BROD_DATA_DIR>/secrets.env when not set here. Set them to manage them yourself
# (openssl rand -hex 32). Changing SECRETS_KEY later makes stored app secrets unreadable.
# ADMIN_SECRET=
# IDENTITY_SECRET=
# SECRETS_KEY=
# BROD_RUNTIME_SECRET=

# ---- data ----
# Brod's own files: the SQLite database (when BROD_DATABASE_URL is unset), app files and generated secrets.
# BROD_DATA_DIR=data
# Brod's database in Postgres instead of SQLite.
# BROD_DATABASE_URL=postgres://brod:password@postgres:5432/brod
# Apply new database migrations at start. false: refuse to start until `brod migrate` has run.
# BROD_AUTO_MIGRATE=true
# Database connections to keep open.
# BROD_DB_CONNECTIONS=8
# App files in a folder other than <BROD_DATA_DIR>/files.
# FILES_DIR=
# App files in an S3-compatible bucket (AWS S3, Cloudflare R2, MinIO) instead of a folder. All four or none.
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_BUCKET=brod-bundles
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_VIRTUAL_HOSTED=0

# ---- email (sign-in links and invitations) ----
# With neither SMTP_URL nor RESEND_API_KEY, a self-hosted Brod prints each email to its log instead of sending it.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# RESEND_API_KEY=
# The sender. Required with SMTP_URL or RESEND_API_KEY.
# EMAIL_FROM=Brod <brod@example.com>
# "Continue with Google" on the sign-in page. Redirect URI: <BROD_PUBLIC_URL>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- server apps (JavaScript backends) ----
# The workerd runtime sidecar. Unset: Brod serves static apps only.
# BROD_RUNTIME_URL=http://runtime:8081
# For the runtime container: restart workerd when it has not answered for this long, or uses more memory than this,
# and the hard memory ceiling Docker puts on the container (keep it above RUNTIME_MEMORY_MB).
# RUNTIME_STALL_MS=5000
# RUNTIME_MEMORY_MB=1536
# RUNTIME_MEM_LIMIT=2g
# The image version Compose runs.
# BROD_VERSION=latest
# Where apps may send data: log (record undeclared hosts, the default), enforce (refuse them) or off.
# BROD_NETWORK=log

# ---- HTTPS with Caddy (docker compose -f docker-compose.yml -f deploy/compose.caddy.yml) ----
# BROD_PUBLIC_URL's host, for Caddy's certificate. ACME_EMAIL (below) gets Let's Encrypt's expiry notices.
# BROD_API_HOST=brod.example.com

# ---- HTTPS without a proxy ----
# Brod serves HTTPS itself: acme (Let's Encrypt or ACME_DIRECTORY) or local (a test CA). Needs an https BROD_PUBLIC_URL.
# BROD_TLS=acme
# ACME_EMAIL=you@example.com
# ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
# ACME_CA_ROOT=
# BROD_HTTPS_LISTEN=0.0.0.0:443
# BROD_HTTP_LISTEN=0.0.0.0:80

# ---- custom domains ----
# The DNS-over-HTTPS resolver that checks a domain's TXT record. Default: Cloudflare's.
# DNS_RESOLVER_URL=https://cloudflare-dns.com/dns-query
# The name custom domains point their CNAME at. Default: BROD_PUBLIC_URL's host.
# CUSTOM_DOMAIN_TARGET=

# ---- features ----
# self-hosted (the default) or hosted (a public multi-tenant service with plans and billing, such as brod.sh).
# BROD_MODE=self-hosted
# The app marketplace shared by the workspaces on this server. Default: on when hosted, off when self-hosted.
# BROD_MARKETPLACE=false
# Phishing scan at deploy, a "Report" link on public apps, and a one-day hold on new free workspaces.
# Default: on when hosted, off when self-hosted.
# BROD_ABUSE_CHECKS=false
# Screenshots of marketplace listings, taken by the preview sidecar (deploy/preview/).
# BROD_PREVIEW_URL=http://preview:8790
# BROD_PREVIEW_SECRET=

# ---- hosted only ----
# Billing through Stripe (BROD_MODE=hosted). Webhook endpoint: <BROD_PUBLIC_URL>/stripe/webhook
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_SOLO=
# STRIPE_PRICE_TEAM=
# A Google Analytics 4 measurement ID for the hosted landing page. Unset: no Google tag anywhere.
# BROD_GA_ID=

# ---- development and tests only ----
# Never on a reachable server: returns sign-in links in API responses.
# DEV_MODE=0
# DEV_MODE only: a smaller free-plan storage limit, in MB, so tests can fill it.
# DEV_FREE_STORAGE_MB=
# A stand-in for Stripe's API in tests.
# STRIPE_API_BASE=https://api.stripe.com
# Postgres for `cargo test` (server/src/db.rs).
# BROD_TEST_DATABASE_URL=
