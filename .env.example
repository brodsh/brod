# Brod on Vercel (or plain Node.js). Copy the names into Vercel: Project Settings > Environment Variables.
# Never commit real values. On Cloudflare these come from wrangler.jsonc and `wrangler secret put` instead.

# ---- addresses ----
# Apps are served at <slug>.<APPS_DOMAIN>. On HTTPS every Brod cookie is __Host- prefixed, so apps on a subdomain
# of brod.sh can neither read nor plant sign-in cookies.
APPS_DOMAIN=apps.brod.sh
# The API, MCP endpoint, sign-in pages and workspace home pages.
API_ORIGIN=https://brod.sh

# ---- secrets (long random values, for example: openssl rand -hex 32) ----
ADMIN_SECRET=
IDENTITY_SECRET=
# Encrypts per-app secrets. Only server apps use them, and those run on the Cloudflare deployment only.
SECRETS_KEY=

# ---- email (sign-in links and invitations) ----
RESEND_API_KEY=
EMAIL_FROM=Brod <no-reply@brod.sh>

# ---- optional: "Continue with Google" (redirect URI: <API_ORIGIN>/auth/google/callback) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- database: libSQL (Turso). The Turso integration on the Vercel Marketplace sets these two. ----
# libsql:// URLs are used over HTTP. Locally a file works too: TURSO_DATABASE_URL=file:brod.db
TURSO_DATABASE_URL=libsql://brod-<your-org>.turso.io
TURSO_AUTH_TOKEN=

# ---- app files: any S3-compatible bucket. Cloudflare R2 shown; AWS S3 and MinIO work the same way. ----
# R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com, region auto, keys from an R2 API token
# with Object Read & Write on this bucket. AWS: endpoint https://s3.<region>.amazonaws.com and S3_REGION=<region>.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_BUCKET=brod-bundles
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# 1 to address the bucket as <bucket>.<endpoint host> (needed by some S3 services; R2 and AWS work without it).
S3_VIRTUAL_HOSTED=

# ---- local Node.js only (npm run start:node), never on Vercel ----
# Keep app files in a folder instead of a bucket.
# FILES_DIR=./.brod-files
# Upload bundles by presigned PUT even off Vercel (always on when running on Vercel with a bucket).
# DIRECT_UPLOADS=1
# Return sign-in links in API responses instead of emailing them. Refused in Vercel's Production environment.
# DEV_MODE=1
