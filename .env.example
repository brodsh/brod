# Brod configuration. Copy to .env and set BROD_ADMIN_EMAIL; everything else has a working default.
# Every variable is listed with what it does in docs/configuration.md. Lines starting with # are off.

# ---- start here ----
# The first admin: on an empty database, Brod makes them admin of a "Default" workspace and logs a one-time sign-in link.
BROD_ADMIN_EMAIL=you@example.com
# Where people and agents reach Brod. Apps get addresses under the same host: http://<app>.<workspace>.localhost:8080.
BROD_PUBLIC_URL=http://localhost:8080

# ---- addresses ----
# The host apps are served under, when it is not BROD_PUBLIC_URL's host. Needs a wildcard DNS record.
# APPS_DOMAIN=apps.example.com
# The address Brod listens on inside its container.
# BROD_LISTEN=0.0.0.0:8080
# 1 behind a proxy you control (Caddy, nginx): take the scheme and client address from X-Forwarded-* headers.
# BROD_TRUST_PROXY=0
# The older name of BROD_PUBLIC_URL, still read when BROD_PUBLIC_URL is not set.
# API_ORIGIN=

# ---- secrets ----
# The bearer token for the operator API (/v1/admin). Generated into <BROD_DATA_DIR>/secrets.env on first start if not set.
# ADMIN_SECRET=
# Keys password-app cookies and visitor counts. Generated on first start if not set.
# IDENTITY_SECRET=
# Signs the identity tokens (JWTs) apps receive: an Ed25519 key, 64 hex characters (openssl rand -hex 32). Its public half is at /.well-known/jwks.json; changing it makes tokens already issued fail. Generated on first start if not set.
# IDENTITY_SIGNING_KEY=
# Encrypts app secrets at rest; changing it makes stored app secrets unreadable. Generated on first start if not set.
# SECRETS_KEY=
# Shared with the runtime sidecar. Generated on first start if not set.
# BROD_RUNTIME_SECRET=
# Where Brod writes BROD_RUNTIME_SECRET for the runtime to read. Default: <BROD_DATA_DIR>/runtime-secret. Compose sets this.
# BROD_RUNTIME_SECRET_FILE=
# Where Brod writes a one-time join token for the node next to it while no node has joined (nodes). Compose sets this.
# BROD_NODE_JOIN_TOKEN_FILE=

# ---- data ----
# Brod's own folder: the SQLite database (without BROD_DATABASE_URL), app files and generated secrets.
# BROD_DATA_DIR=data
# Keep Brod's database in Postgres instead of SQLite. Compose sets this for you.
# BROD_DATABASE_URL=postgres://brod:password@postgres:5432/brod
# Apply new database migrations at start. false: refuse to start until `brod migrate` has run.
# BROD_AUTO_MIGRATE=true
# How many database connections Brod keeps open.
# BROD_DB_CONNECTIONS=8
# Keep app files in this folder instead of <BROD_DATA_DIR>/files.
# FILES_DIR=
# Keep app files in an S3-compatible bucket (AWS S3, Cloudflare R2, MinIO) instead: its endpoint. Set all four S3_* or none.
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# The bucket for app files.
# S3_BUCKET=brod-bundles
# The bucket's access key id.
# S3_ACCESS_KEY_ID=
# The bucket's secret access key.
# S3_SECRET_ACCESS_KEY=
# The bucket's region; "auto" works for R2.
# S3_REGION=auto
# 1 to address the bucket as <bucket>.<endpoint host>, for services that need it.
# S3_VIRTUAL_HOSTED=0

# ---- email ----
# Send sign-in links and invitations through this SMTP server (smtps:// for TLS, smtp:// for STARTTLS).
# SMTP_URL=smtps://user:password@smtp.example.com:465
# Send them through Resend (https://resend.com) instead. With neither, a self-hosted Brod prints each email to its log.
# RESEND_API_KEY=
# The sender address. Required with SMTP_URL or RESEND_API_KEY.
# EMAIL_FROM=Brod <brod@example.com>
# Offer "Continue with Google" on the sign-in page. Redirect URI: <BROD_PUBLIC_URL>/auth/google/callback.
# GOOGLE_CLIENT_ID=
# The Google OAuth client's secret.
# GOOGLE_CLIENT_SECRET=

# ---- server apps ----
# Where Brod reaches the runtime sidecar that runs apps' server code. Unset: static apps only. Compose sets this.
# BROD_RUNTIME_URL=http://runtime:8081
# Runtime container: restart workerd when it has not answered for this many milliseconds (an app stuck in a loop).
# RUNTIME_STALL_MS=5000
# Runtime container: restart workerd when it uses more memory than this, in MB.
# RUNTIME_MEMORY_MB=1536
# Runtime container: the hard memory ceiling Docker enforces. Keep it above RUNTIME_MEMORY_MB.
# RUNTIME_MEM_LIMIT=2g

# ---- container apps ----
# Container apps: a source folder with a Dockerfile, built and run on a node (docs/apps.md, Container apps). They need a node with Docker and the registry below.
# Who may deploy them: "trusted" (every workspace; an image may even run as root), "on" (every workspace, never as root) or "off". Default: trusted self-hosted, off hosted.
# BROD_CONTAINERS=trusted
# The image registry (registry:2 with token auth) only Brod talks to. Unset: no container apps. Compose sets this.
# BROD_REGISTRY_URL=http://registry:5000
# Signs the registry's tokens: an ECDSA P-256 key, PKCS#8 in base64. Generated into <BROD_DATA_DIR>/secrets.env if not set, hosted too.
# REGISTRY_SIGNING_KEY=
# Where Brod writes the certificate of that key, for the registry's REGISTRY_AUTH_TOKEN_ROOTCERTBUNDLE. Default: <BROD_DATA_DIR>/registry-token.crt. Compose sets this.
# BROD_REGISTRY_CERT_FILE=
# What the names of app containers, networks and images on nodes start with.
# BROD_CONTAINER_PREFIX=brod
# Container apps' databases (request_database): the admin URL of apps-postgres, a Postgres server of its own, never Brod's database. Unset: request_database answers database_unavailable. Compose sets this (a socket, no network).
# BROD_APPS_DATABASE_URL=postgres://brod_admin@%2Fvar%2Frun%2Fapps-postgresql/postgres
# The admin password for BROD_APPS_DATABASE_URL. Generated into <BROD_DATA_DIR>/secrets.env if not set, hosted too.
# APPS_DATABASE_PASSWORD=
# Where Brod writes that password, for apps-postgres's POSTGRES_PASSWORD_FILE. Compose sets this.
# BROD_APPS_DATABASE_PASSWORD_FILE=
# The folder with pg_dump and pg_restore for backups, of the same major version as apps-postgres. Default: the PATH. Brod's image sets this.
# BROD_PG_BIN_DIR=
# Where apps may send data: log (record undeclared hosts), enforce (refuse them) or off.
# BROD_NETWORK=log
# The image version Compose runs.
# BROD_VERSION=latest

# ---- HTTPS with Caddy ----
# BROD_PUBLIC_URL's host, for Caddy's certificate (docker compose -f docker-compose.yml -f deploy/compose.caddy.yml).
# BROD_API_HOST=brod.example.com

# ---- HTTPS without a proxy ----
# Serve HTTPS from Brod itself: acme (Let's Encrypt or ACME_DIRECTORY) or local (a test CA). Needs an https BROD_PUBLIC_URL.
# BROD_TLS=acme
# The email address Let's Encrypt (or Caddy) sends certificate expiry notices to.
# ACME_EMAIL=you@example.com
# Another ACME certificate authority's directory URL.
# ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
# A root certificate (PEM file) to trust for that authority, for test CAs.
# ACME_CA_ROOT=
# Where Brod listens for HTTPS when BROD_TLS is set.
# BROD_HTTPS_LISTEN=0.0.0.0:443
# Where Brod listens for plain HTTP (redirects and ACME challenges) when BROD_TLS is set.
# BROD_HTTP_LISTEN=0.0.0.0:80

# ---- custom domains ----
# The DNS-over-HTTPS resolver that checks a custom domain's TXT record and whether its DNS is on Cloudflare. Default: Cloudflare's.
# DNS_RESOLVER_URL=https://cloudflare-dns.com/dns-query
# The name custom domains point their CNAME at. Default: BROD_PUBLIC_URL's host.
# CUSTOM_DOMAIN_TARGET=

# ---- logs ----
# The least important log events written: error, warn, info or debug.
# BROD_LOG=info
# text (one line per event) or json (one JSON object per line, for log collectors).
# BROD_LOG_FORMAT=text

# ---- features ----
# self-hosted (one organisation's Brod) or hosted (a public service with plans and billing, such as brod.sh).
# BROD_MODE=self-hosted
# The app marketplace shared by the workspaces on this server. Default: off self-hosted, on hosted.
# BROD_MARKETPLACE=false
# Phishing scan at deploy, a "Report" link on public apps, a one-day hold on new free workspaces. Default: off self-hosted, on hosted.
# BROD_ABUSE_CHECKS=false
# Where Brod reaches the preview sidecar that screenshots marketplace listings (deploy/compose.preview.yml).
# BROD_PREVIEW_URL=http://preview:8790
# Shared with the preview sidecar; at least 16 random characters.
# BROD_PREVIEW_SECRET=

# ---- instance settings ----
# The operators change these in the admin console (/admin, docs/plans/admin-mode.md); BROD_MARKETPLACE and BROD_ABUSE_CHECKS above are instance settings too. Setting one here locks it: the console shows it read-only. A number or "unlimited". Running (live) apps per workspace; paused apps do not count. A hosted workspace's plan applies instead, unless an operator overrides it. Default: unlimited.
# BROD_LIMIT_RUNNING_APPS=unlimited
# Members per workspace. Guests do not count. Default: unlimited.
# BROD_LIMIT_MEMBERS=unlimited
# Storage per workspace in MB: bundles, files and app data. Default: unlimited.
# BROD_LIMIT_STORAGE_MB=unlimited
# Days of analytics a workspace keeps. Default: 365.
# BROD_LIMIT_ANALYTICS_DAYS=365
# Workspaces on this server. Existing ones are never removed. Default: unlimited.
# BROD_MAX_WORKSPACES=unlimited
# People with an account on this server. People who already have one can always sign in. Default: unlimited.
# BROD_MAX_USERS=unlimited
# Who may create a workspace: operators, workspace_admins or anyone_verified. Default: workspace_admins self-hosted, anyone_verified hosted.
# BROD_WORKSPACE_CREATION=workspace_admins
# Comma-separated email domains allowed to sign up, such as acme.com. Empty: any domain. Invitations still work.
# BROD_ALLOWED_EMAIL_DOMAINS=
# Deploys per workspace per hour.
# BROD_RATE_DEPLOYS_PER_HOUR=30
# REST and MCP calls per connection per minute.
# BROD_RATE_CALLS_PER_MINUTE=600
# Workspaces one person may create per day.
# BROD_RATE_WORKSPACES_PER_USER_DAY=3
# Use people's real email addresses as the author of exported git commits. Off: <user id>@users.noreply.<apps domain>.
# BROD_GIT_REAL_EMAILS=false
# Largest git bundle or repository (in MB) import_app accepts.
# BROD_GIT_MAX_IMPORT_MB=50
# How often (minutes) Brod polls the remote of a git mirror with inbound sync when no webhook arrived recently. 0: never.
# BROD_GIT_SYNC_POLL_MINUTES=10
# Bot and flood protection for apps (shield.rs): a request limit per address, blocking addresses that scan for vulnerable paths, and a proof-of-work check for suspicious or very busy clients. Off, traffic is still classified for analytics.
# BROD_SHIELD=true
# Requests one address may make to apps per minute before it is answered 429.
# BROD_SHIELD_REQUESTS_PER_MINUTE=1200
# Requests per minute from one address after which its page loads must pass the proof-of-work check. 0 turns this trigger off.
# BROD_SHIELD_CHALLENGE_PER_MINUTE=300
# Page loads classified suspicious (odd headers, bursts, many errors) must pass the proof-of-work check.
# BROD_SHIELD_CHALLENGE_SUSPICIOUS=true
# Difficulty of the proof-of-work check, in leading zero bits of a SHA-256 hash. Each extra bit doubles the work; 16 takes a browser well under a second.
# BROD_SHIELD_CHALLENGE_BITS=16
# How long (hours) a client that passed the check is let through without another one.
# BROD_SHIELD_PASS_HOURS=24
# Probe paths (/wp-login.php, /.env, /.git/, ...) refused to one address within 10 minutes before it is labelled a scanner and blocked. 0 never blocks.
# BROD_SHIELD_SCANNER_PROBES=8
# How long (minutes) a scanner's address stays blocked.
# BROD_SHIELD_BLOCK_MINUTES=60
# Page views per minute from one address above which its visits are labelled suspicious in analytics. 0 turns this signal off.
# BROD_TRAFFIC_BURST_VIEWS_PER_MINUTE=30

# ---- hosted only ----
# Stripe secret key, for billing (BROD_MODE=hosted). Webhook endpoint: <BROD_PUBLIC_URL>/stripe/webhook.
# STRIPE_SECRET_KEY=
# The signing secret of that Stripe webhook endpoint.
# STRIPE_WEBHOOK_SECRET=
# The Stripe price id of the Solo plan.
# STRIPE_PRICE_SOLO=
# The Stripe price id of the Team plan.
# STRIPE_PRICE_TEAM=
# A Google Analytics 4 measurement ID for the hosted landing page. Unset: no Google tag anywhere.
# BROD_GA_ID=

# ---- development and tests only ----
# Never on a reachable server: returns sign-in links in API responses.
# DEV_MODE=0
# With DEV_MODE: a smaller free-plan storage limit in MB, so tests can fill it.
# DEV_FREE_STORAGE_MB=
# With DEV_MODE: git mirrors may use http:// and 127.0.0.1 remotes, so tests can serve a repository.
# DEV_ALLOW_LOOPBACK_GIT=0
# A stand-in for Stripe's API, for tests.
# STRIPE_API_BASE=https://api.stripe.com
# A Postgres database for `cargo test` to run its database tests against.
# BROD_TEST_DATABASE_URL=
# Debug builds only: read the admin page from this folder on every request, for editing it without a rebuild.
# BROD_DEV_ASSETS=server/src
